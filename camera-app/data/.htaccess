# חסימת גישה ישירה לכל תיקיית הנתונים.
#
# כאן יושבים מסד הנתונים (משתמשים, סיסמאות מצלמות מוצפנות), ההקלטות
# והצילומים, תיבת ה-FTP שהמצלמות מעלות אליה, ומקטעי השידור החי.
# שום דבר מזה אינו ציבורי: הקלטות מהבית מוגשות רק דרך media.php,
# שבודק שהמבקש מחובר. גם media/ חסומה — בניגוד למתכונים, שם המדיה
# ציבורית — כי כאן כל קובץ הוא מצלמה בבית של מישהו.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
