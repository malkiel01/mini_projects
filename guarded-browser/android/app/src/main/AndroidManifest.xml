<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!--
      המשך ריצה מחוץ לאפליקציה.

      בלי שירות חזית אנדרואיד הורג את התהליך ביציאה — ואז נקטעת לא
      רק הצפייה אלא גם האכיפה: הפעימה שסופרת את מכסת הזמן ומקבלת
      השעיה מהשרת מפסיקה לרוץ.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- עדכון האפליקציה כשההורה מבקש: הורדה ופתיחת מסך ההתקנה של אנדרואיד (הילד מאשר). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- פטור מאופטימיזציית סוללה, כדי שהאכיפה לא תיעצר ברקע (מבוקש במסלול ההקמה). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- עדכון חובה (Updater): הבדיקה ברקע נשמרת אחרי הפעלה מחדש, וההודעה קופצת במסך מלא. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>

    <application
        android:name=".GuardApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.GuardedBrowser">

        <!-- המסך הראשון: צימוד בקוד מאפליקציית ההורה (שלב 4). -->
        <activity android:name=".PairActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:exported="false"/>
        <activity android:name=".ParentActivity" android:exported="false"/>

        <!-- סורק ה-QR: לאורך, לפי החיישן — הספרייה נועלת לרוחב כברירת מחדל. -->
        <activity android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor" tools:replace="screenOrientation"/>

        <activity android:name=".HomeActivity" android:exported="false"/>
        <activity android:name=".SetupActivity" android:exported="false"/>
        <activity android:name=".BlockedActivity" android:exported="false"
            android:excludeFromRecents="true" android:launchMode="singleTask"
            android:theme="@style/Theme.GuardedBrowser"/>

        <!-- שירות הנגישות: מזהה איזו אפליקציה עלתה, כדי לחסום אפליקציות שההורה חסם (שלב 11). -->
        <service android:name=".AppGuardService" android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/app_guard_service"/>
        </service>

        <!-- מנהל מכשיר: הפעלה דרך מסך האישור של אנדרואיד, מופיע בהגדרות. -->
        <receiver android:name=".MigdalorAdmin" android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin"
                android:resource="@xml/device_admin"/>
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>
            </intent-filter>
        </receiver>

        <!-- ‏excludeFromRecents ו-noHistory אינם מוגדרים כאן בכוונה:
             חסימת התצוגה המקדימה נקבעת לפי ההרשאה, ב-FLAG_SECURE.

             ‏smallestScreenSize ו-screenLayout נדרשים ל-PiP: בלעדיהם
             אנדרואיד יוצר מחדש את ה-Activity במעבר לחלון הצף,
             והנגן מתחיל מהתחלה. -->
        <activity android:name=".BrowserActivity" android:exported="false"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"/>

        <!-- עדכון חובה (Updater): המסך הנעול, הבדיקה ברקע, ותוצאת ההתקנה. -->
        <activity android:name=".UpdateActivity" android:exported="false"
            android:excludeFromRecents="true" android:launchMode="singleTask"/>
        <service android:name=".UpdateJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <receiver android:name=".Updater$InstallResult" android:exported="false"/>

        <service android:name=".GuardService" android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>
    </application>
</manifest>
