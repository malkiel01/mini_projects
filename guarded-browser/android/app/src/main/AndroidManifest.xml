<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!--
      המשך ריצה מחוץ לאפליקציה.

      בלי שירות חזית אנדרואיד הורג את התהליך ביציאה — ואז נקטעת לא
      רק הצפייה אלא גם האכיפה: הפעימה שסופרת את מכסת הזמן ומקבלת
      השעיה מהשרת מפסיקה לרוץ.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.GuardedBrowser">

        <activity android:name=".LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".HomeActivity" android:exported="false"/>

        <!-- ‏excludeFromRecents ו-noHistory אינם מוגדרים כאן בכוונה:
             חסימת התצוגה המקדימה נקבעת לפי ההרשאה, ב-FLAG_SECURE.

             ‏smallestScreenSize ו-screenLayout נדרשים ל-PiP: בלעדיהם
             אנדרואיד יוצר מחדש את ה-Activity במעבר לחלון הצף,
             והנגן מתחיל מהתחלה. -->
        <activity android:name=".BrowserActivity" android:exported="false"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"/>

        <service android:name=".GuardService" android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>
    </application>
</manifest>
