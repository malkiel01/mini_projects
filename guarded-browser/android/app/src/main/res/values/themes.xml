<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GuardedBrowser" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/brand_ink</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/dim</item>
    </style>

    <!-- כפתור ראשי: מותג, רדיוס 10, גובה 48 -->
    <style name="MgButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="MgButtonGhost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="MgButtonText" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/brand</item>
    </style>
    <!-- כפתור בסרגל הדפדפן: סמל, 40dp, עם משוב לחיצה. -->
    <style name="MgBarButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="MgSection">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
