<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp" android:layout_margin="4dp"
    android:background="?attr/selectableItemBackground" android:clickable="true"
    android:focusable="true" android:layoutDirection="rtl">
    <TextView android:id="@+id/tileLabel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tileUrl" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="13sp"
        android:textColor="@color/dim" android:layoutDirection="ltr" android:textDirection="ltr"/>
</LinearLayout>
