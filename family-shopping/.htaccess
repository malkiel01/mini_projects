# קניות משותפות — mini_projects/family-shopping
#
# בפריסה, השער (platform/build-gate.php) מוסיף בראש הקובץ בלוק משלו: כל
# קובץ שאינו PHP עובר ב-platform/gate.php, ו-.user.ini מריץ את השער לפני כל
# סקריפט PHP. הכללים כאן הם ההגנות של האפליקציה עצמה, מתחת לשער.

RewriteEngine On

# === הגנות ===

# כל קובץ שמתחיל בנקודה — .env (המסד, SMTP, VAPID) וגיבויי .htaccess.
# הכלל חל על שמות קבצים בלבד, ולכן .well-known ממשיך לעבוד.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# תיקיות פנימיות שאין שום סיבה לגשת אליהן מהדפדפן.
# cron/ ו-tools/ רצים מהטרמינל בלבד; tests/ לא נפרסות בכלל.
RewriteRule ^(tests|cron|tools|vendor|logs|cache|sessions)/ - [F,L]

# config.php ו-includes/ — רק דרך require מקבצי PHP אחרים
<Files config.php>
    Require all denied
</Files>
RewriteCond %{THE_REQUEST} \s/+[^\s]*/includes/[^\s]*\.php[\s?] [NC]
RewriteRule ^ - [F]

# קבצי גיבוי, SQL ויומנים
<FilesMatch "\.(bak|backup|sql|log|ini)$">
    Require all denied
</FilesMatch>

# פעולות בדשבורד ובאירוע — רק מ-fetch של האפליקציה (בנוסף ל-CSRF)
RewriteCond %{REQUEST_METHOD} POST
RewriteCond %{HTTP:X-Requested-With} !XMLHttpRequest
RewriteRule ^(dashboard|group)\.php$ - [F,L]

# כתובת שלא קיימת — לדף הראשי (חוץ מקבצים סטטיים, שיחזירו 404 אמיתי)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpe?g|gif|svg|ico|json|webmanifest|html)$
RewriteRule ^ index.php [L]

Options -Indexes -MultiViews
RedirectMatch 404 /\.git

# === כותרות ===
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    <FilesMatch "\.php$">
        Header set X-Frame-Options "SAMEORIGIN"
    </FilesMatch>
    <FilesMatch "\.webmanifest$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    # ה-service worker תמיד מהרשת, כדי שעדכון שלו יגיע מיד
    <FilesMatch "service-worker\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

AddType application/manifest+json .webmanifest
AddType text/javascript .js
AddDefaultCharset UTF-8

# הגבלת גודל ההעלאה. בשרת (LiteSpeed) php_value כאן לא חל — המגבלה בפועל
# נאכפת בקוד (MAX_FILE_SIZE ב-config.php). נשאר כמו באתר הקודם.
php_value upload_max_filesize 5M
php_value post_max_size 10M

ErrorDocument 403 /mini_projects/family-shopping/index.php
ErrorDocument 404 /mini_projects/family-shopping/index.php
