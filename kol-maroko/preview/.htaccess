# התצוגה החיה (F4): כל כתובת כאן — preview/<אסימון>/<נתיב בפרויקט> — מוגשת על ידי index.php, שבודק את האסימון
# ושולח את כותרות הבידוד. אין בתיקייה הזו קבצים סטטיים; RewriteEngine משלה = הכללים של התיקייה שמעל אינם חלים כאן.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ index.php [L]
</IfModule>
# ../.htaccess חוסם index.html (גוף הסטודיו) לגישה ישירה, ו-<Files> חל גם על תת-תיקיות. כאן index.html הוא קובץ של
# הפרויקט שמוגש מ-index.php — לכן מותר במפורש, גם בשרת שמתאים את <Files> לנתיב המבוקש ולא לקובץ שעל הדיסק.
<Files "index.html">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Allow from all
    </IfModule>
</Files>
