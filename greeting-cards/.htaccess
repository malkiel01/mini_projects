# הדף והקוד נבדקים מול השרת בכל טעינה.
# בלי זה הטלפון (ובעיקר ה-WebView של אפליקציית האנדרואיד) מחזיק index.html ישן ימים
# שלמים, ושינוי שנפרס — כמו ביטול מסך הכניסה של האפליקציה — פשוט לא מופיע.
# הבדיקה מסתיימת ב-304 כשלא השתנה דבר.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|mjs|css|webmanifest|md|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
