{
  "name": "כלים דיגיטליים — משפחת האפליקציות",
  "short_name": "כלים דיגיטליים",
  "description": "כל האפליקציות שלך במקום אחד — כניסה אחת, אייקון אחד במסך הבית",
  "lang": "he",
  "dir": "rtl",
  "id": "../",
  "start_url": "home/",
  "scope": "home/",
  "display": "standalone",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "orientation": "any",
  "background_color": "#f5f6fa",
  "theme_color": "#4338ca",
  "categories": [
    "productivity",
    "utilities",
    "business"
  ],
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "assets/screenshots/narrow.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "האפליקציות שלך, מסודרות בקטגוריות"
    },
    {
      "src": "assets/screenshots/wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "כל האפליקציות במקום אחד"
    }
  ],
  "shortcuts": [
    {
      "name": "ניהול",
      "short_name": "ניהול",
      "url": "home/#admin",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://mbe-plus.com/mini_projects/platform/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false
