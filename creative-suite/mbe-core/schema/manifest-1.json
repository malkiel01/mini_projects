{
  "$id": "https://mbe-plus.com/mini_projects/creative-suite/mbe-core/schema/manifest-1.json",
  "title": "mbe manifest 1.x",
  "description": "רשימת התוכן של קובץ ‎.mbe — mbe-format.md סעיף 3. שדות לא מוכרים מותרים ונשמרים (סעיף 4).",
  "type": "object",
  "required": ["format", "version", "kind", "document"],
  "properties": {
    "format": { "const": "mbe" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "id": { "type": "string", "maxLength": 64, "description": "מזהה המסמך (1.1) — UUID v4. תבנית לא תקינה: אזהרה manifest-id-invalid בליבה, לא שגיאה; נשמר כמו שהוא" },
    "created": { "$ref": "#/$defs/stamp" },
    "modified": { "$ref": "#/$defs/stamp" },
    "document": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "document.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "media": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "type", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^media/[0-9a-f]{64}(\\.[a-z0-9]{1,8})?$" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "type": { "$ref": "#/$defs/mime" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "renditions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["path", "type", "sourceSha256", "gaps"],
        "properties": {
          "path": { "type": "string", "pattern": "^renditions/[^/]{1,128}$" },
          "type": { "$ref": "#/$defs/mime" },
          "sourceSha256": { "$ref": "#/$defs/sha256" },
          "by": { "$ref": "#/$defs/appId" },
          "gaps": { "type": "array", "maxItems": 1000, "items": { "type": "string", "maxLength": 500 } }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mime": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
    "appId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "stamp": {
      "type": "object",
      "required": ["app", "at"],
      "properties": {
        "app": { "$ref": "#/$defs/appId" },
        "appVersion": { "type": "string", "maxLength": 64 },
        "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$" }
      }
    }
  }
}
