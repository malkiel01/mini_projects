{
  "permissions": {
    "allow": [
      "mcp__claude-code-remote__get_session",
      "mcp__claude-code-remote__list_sessions",
      "mcp__claude-code-remote__get_trigger",
      "mcp__claude-code-remote__list_triggers",
      "mcp__claude-code-remote__create_trigger",
      "mcp__claude-code-remote__send_later",
      "mcp__Claude_Code_Remote__get_session",
      "mcp__Claude_Code_Remote__list_sessions",
      "mcp__Claude_Code_Remote__get_trigger",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Claude_Code_Remote__send_later"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "f=\"$HOME/.claude-tasks-bridge/hook.sh\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/claude-tasks/bridge/hook.sh\"; [ -f \"$f\" ] && bash \"$f\" prompt; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "f=\"$HOME/.claude-tasks-bridge/hook.sh\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/claude-tasks/bridge/hook.sh\"; [ -f \"$f\" ] && bash \"$f\" stop; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "f=\"$HOME/.claude-tasks-bridge/hook.sh\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/claude-tasks/bridge/hook.sh\"; [ -f \"$f\" ] && bash \"$f\" choice; exit 0"
          }
        ]
      },
      {
        "matcher": ".*__(create_trigger|send_later|get_session|list_sessions|get_trigger|list_triggers)$",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "f=\"$HOME/.claude-tasks-bridge/hook.sh\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/claude-tasks/bridge/hook.sh\"; [ -f \"$f\" ] && bash \"$f\" allow; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "f=\"$HOME/.claude-tasks-bridge/hook.sh\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/claude-tasks/bridge/hook.sh\"; [ -f \"$f\" ] && bash \"$f\" choice-done; exit 0"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "f=\"$HOME/.claude-tasks-bridge/hook.sh\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/claude-tasks/bridge/hook.sh\"; [ -f \"$f\" ] && bash \"$f\" resolved; exit 0"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "f=\"$HOME/.claude-tasks-bridge/hook.sh\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/claude-tasks/bridge/hook.sh\"; [ -f \"$f\" ] && bash \"$f\" notify; exit 0"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "timeout": 620,
            "command": "f=\"$HOME/.claude-tasks-bridge/hook.sh\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/claude-tasks/bridge/hook.sh\"; [ -f \"$f\" ] && bash \"$f\" permission; exit 0"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "f=\"$HOME/.claude-tasks-bridge/hook.sh\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/claude-tasks/bridge/hook.sh\"; [ -f \"$f\" ] && bash \"$f\" resolved; exit 0"
          }
        ]
      }
    ]
  }
}
