# הדף והקוד נבדקים מול השרת בכל טעינה.
#
# בלי זה, דפדפן שמחזיק index.html ישן מהמטמון מזווג אותו עם JS חדש
# שנפרס — וחסר אלמנט אחד מספיק כדי שהדף לא ייטען כלל. הבדיקה עולה
# בקשה קטנה שמסתיימת ב-304 כשלא השתנה דבר.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|mjs|css|webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
