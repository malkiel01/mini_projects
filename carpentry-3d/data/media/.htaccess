# תמונות החומרים: כן מוגשות לדפדפן, אבל שום דבר כאן אינו מורץ כקוד.
# רק המנהל מעלה לכאן, והקוד בודק את התוכן ב-getimagesize — זו החגורה השנייה.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
AddType text/plain .php .phtml .phps .cgi .pl .py .sh

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# רק תמונות מוגשות. כל השאר נחסם, גם אם נשמר בטעות.
<FilesMatch "\.(?!(jpe?g|png|webp)$)[^.]*$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
