{
  "fields": [
    { "key": "f1", "type": "number", "label": "כמות", "placeholder": "" },
    { "key": "price", "type": "number", "label": "מחיר ליחידה", "placeholder": "מחיר" },
    { "key": "start", "type": "date", "label": "תאריך התחלה" },
    { "key": "vat_on", "type": "checkbox", "label": "כולל מע\"מ" },
    { "key": "name", "type": "text", "label": "שם" },
    { "key": "items", "type": "table", "label": "פריטים", "columns": [
      { "key": "desc", "label": "תיאור", "type": "text" },
      { "key": "qty", "label": "כמות", "type": "number" },
      { "key": "unit", "label": "מחיר", "type": "number" },
      { "key": "line", "label": "סה\"כ", "type": "calc", "formula": "qty * unit" }
    ] },
    { "key": "sub", "type": "calc", "label": "סכום ביניים", "formula": "sum(items.line)" },
    { "key": "vat", "type": "calc", "label": "מע\"מ", "formula": "if(vat_on, round(sub * 0.18, 2), 0)" },
    { "key": "total", "type": "calc", "label": "סה\"כ לתשלום", "formula": "סכום_ביניים + מע\"מ" },
    { "key": "due", "type": "calc", "label": "תאריך תשלום", "formula": "days(start, 30)" }
  ],
  "values": {
