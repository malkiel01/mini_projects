      [{ "has_g": "", "g_name": "דוד" }, ["has_g", "kind", "priv", "note"]],
      [{ "kind": "חברה" }, ["has_g", "kind", "biz"]],
      [{ "kind": "פרטי" }, ["has_g", "kind", "priv"]]
    ]
  }
