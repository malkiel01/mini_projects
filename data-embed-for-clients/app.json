{
  "id": "data-embed-for-clients",
  "name": "הטמעת נתונים לריכוז לקוחות",
  "icon": "📄",
  "description": "העלאת תמונה, בחירת פונט ומיקום, והפקת קבצי PDF מרובים עם טקסט מותאם אישית לכל לקוח.",
  "category": "documents",
  "entry": "index.html",
  "gate": true,
  "public": [
    "sign.html",
    "track.html",
    "signed/**",
    "api.php?action=get_template|save_signed|list_signed|render",
    "manifest.webmanifest",
    "service-worker.js",
    "assets/icons/**",
    "assets/icon.svg"
  ],
  "install": {
    "release": "data-embed-for-clients-store"
  }
}
