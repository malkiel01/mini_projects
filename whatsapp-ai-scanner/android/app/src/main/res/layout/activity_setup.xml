<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="20dp" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="גשר סורק וואטסאפ" android:textSize="22sp" android:textStyle="bold"
            android:paddingBottom="12dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="הדביקו את אסימון הצימוד מהגדרות האתר, ואת מזהה החשבון שאליו לשייך את ההודעות."
            android:paddingBottom="16dp"/>

        <EditText android:id="@+id/server" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="כתובת השרת"
            android:inputType="textUri"/>

        <EditText android:id="@+id/token" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="אסימון צימוד"
            android:inputType="textPassword"/>

        <Button android:id="@+id/saveBtn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="שמור אסימון וטען חשבונות"
            android:layout_marginTop="8dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="חשבון פעיל לסריקה (כל מה שתסרוק ייכנס אליו):"
            android:layout_marginTop="16dp"/>

        <Spinner android:id="@+id/accountSpinner" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"/>

        <Button android:id="@+id/refreshAccountsBtn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="רענן רשימת חשבונות"
            android:layout_marginTop="4dp"/>

        <Button android:id="@+id/openAccessibilityBtn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="הפעל את שירות הנגישות"
            android:layout_marginTop="8dp"/>

        <Button android:id="@+id/testBtn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="בדוק חיבור לשרת"
            android:layout_marginTop="8dp"/>

        <Button android:id="@+id/autoScanBtn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="סרוק צ'אט פתוח אוטומטית"
            android:layout_marginTop="8dp"/>

        <Button android:id="@+id/scanFilesBtn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="סרוק קבצים ותמונות (PDF/תמונות)"
            android:layout_marginTop="8dp"/>

        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="16dp"/>

        <TextView android:id="@+id/scanStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="8dp"
            android:textStyle="italic"/>
    </LinearLayout>
</ScrollView>
