    { "q": "אל", "must": ["למנצח אל הנחילות"], "must_not": ["שמע ישראל", "אלהינו מלך"], "why": "מילה קצרה: בלי התאמה בתוך מילה" },
    { "q": "דרך צדיקים", "must": ["כי יודע ה' דרך צדיקים"], "must_not": ["ובדרך חטאים", "בעדת צדיקים"], "why": "כל המילים באותו בלוק" },
    { "q": "רשע", "must": [], "must_not": ["בעצת רשעים"], "why": "בלי סיומות: 'רשע' אינו 'רשעים'" },
