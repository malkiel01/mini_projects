# הדף והקוד נבדקים מול השרת בכל טעינה, כדי שמסך חדש שנפרס יופיע מיד גם
# בטלפון. הבדיקה מסתיימת ב-304 כשלא השתנה דבר.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
# lib/ — קוד PHP שנטען מ-api.php בלבד, לא נקרא ישירות מהדפדפן.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^lib/ - [F,L]
</IfModule>
