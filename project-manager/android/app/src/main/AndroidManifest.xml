<?xml version="1.0" encoding="utf-8"?>
<!-- ניהול פרויקטים לאנדרואיד: האתר בתוך WebView, ושיתוף אליו מכל אפליקציה.
     "שיתוף" ← "פרויקטים" — מסך "לאן לשמור?" של האתר; ובשורה העליונה של תפריט השיתוף — התיקיות
     האחרונות ששיתפת אליהן (Sharing Shortcuts, res/xml/shortcuts.xml), לחיצה אחת שומרת לשם. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PM">

        <!-- האישור ההדדי: האפליקציה מצהירה על האתר, והאתר (assetlinks.json) עליה — כך הפלטפורמה יודעת שהיא מותקנת -->
        <meta-data android:name="asset_statements" android:value="@string/asset_statements" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- קישור לאתר נפתח באפליקציה (App Link) — כך "פתיחה" בכרטיס של הכלים הדיגיטליים מגיעה לכאן עם
                 ?platform-handoff=<קוד>, והשער מחבר את המשתמש (platform/docs/auth.md, "העברת התחברות") -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="mbe-plus.com" android:pathPrefix="/mini_projects/project-manager/" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- אנדרואיד 9 ומטה: אותם קיצורים דרך ספריית sharetarget -->
            <meta-data android:name="android.service.chooser.chooser_target_service"
                android:value="androidx.sharetarget.ChooserTargetServiceCompat" />
        </activity>

        <!-- צילום מהמצלמה לשדה קובץ באתר — הקובץ הזמני נחשף למצלמה דרך FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
